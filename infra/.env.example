# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=networkhub
POSTGRES_PASSWORD=networkhub_secret
POSTGRES_DB=networkhub

# ─── Application ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://networkhub:networkhub_secret@localhost:5432/networkhub
REDIS_URL=redis://localhost:6379/0

# IMPORTANT: Generate a strong random key for production
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_in_production_use_32_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAGIC_LINK_EXPIRE_MINUTES=15

# ─── Email Provider ───────────────────────────────────────────────────────────
# Choose: sendgrid | mailgun | ses
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

EMAIL_FROM=noreply@networkhub.app
EMAIL_FROM_NAME=NetworkHub
EMAIL_DAILY_LIMIT=20

# ─── CORS (comma-separated origins for production) ───────────────────────────
ALLOWED_ORIGINS=https://app.networkhub.app

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
ENVIRONMENT=development

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
